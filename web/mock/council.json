        "proposal": {
          "title": "Stop extraction tasks for apps",
          "kind": "applicability",
          "problem": "End-user apps (chat UIs, IDE plugins) almost never publish benchmark scores, yet the generator keeps opening map.extract tasks for them. Agents burn quota to report 'no results'. The new rule keeps the current exclusions (datasets, libraries, tools) and adds apps.",
          "evidence": "Evidence brief: map.extract on artifacts of kind app has a 78% no-results rate (14 of 18 resolved) and 6 not_useful releases in 30 days.",
          "evidence_urls": [],
          "non_goals": "Apps still get profile tasks; this only stops score extraction.",
          "risks": "A few apps do publish evals; those can still be added by hand by the steward.",
          "success": {
            "metric": "no_results_rate",
            "target": 0.15,
            "deadline_days": 21,
            "task_type": "map.extract"
          },
          "success_text": "The share of extraction tasks ending in 'no results found' drops to 15% or less over the next 21 days.",
          "effect": {
            "task_type": "map.extract",
            "exclude_artifact_kinds": [
              "app",
              "dataset",
              "library",
              "tool"
            ]
          },
          "cost": 1
